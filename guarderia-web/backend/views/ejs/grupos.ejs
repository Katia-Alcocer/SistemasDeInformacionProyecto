<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Grupos de guardería</title></head><body><h1>Grupos de guardería</h1><table><thead><tr><th>Código</th><th>Grupo</th><th>Capacidad</th><th>Responsable</th><th>Estado</th></tr></thead><tbody><% for(const grupo of grupos){ %><tr><td><%= grupo.codigo %></td><td><%= grupo.nombre %></td><td><%= grupo.capacidad %></td><td><%= grupo.responsable || 'Sin asignar' %></td><td><%= grupo.activo ? 'Activo' : 'Inactivo' %></td></tr><% } %></tbody></table></body></html>
